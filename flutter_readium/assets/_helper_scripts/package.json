{
  "version": "1.0.0",
  "description": "JavaScript helpers for flutter-readium",
  "private": true,
  "name": "readium-js",
  "keywords": [
    "rollup",
    "typescript",
    "sass"
  ],
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.0.0",
    "rollup": "^4.62.3",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-serve": "^3.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.102.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs --environment BUILD:production",
    "build:stats": "rollup -c rollup.config.mjs --environment BUILD:production,STATS",
    "build:dev": "rollup -c rollup.config.mjs --environment BUILD:development",
    "serve": "rollup -c rollup.config.mjs --watch --environment SERVE,BUILD:development"
  },
  "dependencies": {
    "@readium/css": "^2.0.5",
    "css-selector-generator": "^3.9.2",
    "lit": "~3.3.3"
  }
}
