{
  "version": "1.0.0",
  "description": "JavaScript helpers for flutter-readium",
  "private": true,
  "name": "readium-js",
  "keywords": [
    "rollup",
    "typescript",
    "sass"
  ],
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-replace": "^6.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/animejs": "^3.1.13",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.5",
    "rollup": "^4.0.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-serve": "^3.0.0",
    "sass": "^1.99.0",
    "tslib": "^2.8.0",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production rollup -c rollup.config.ts --configPlugin typescript",
    "build:flutter": "cross-env NODE_ENV=production IS_FLUTTER=1 rollup -c rollup.config.ts --configPlugin typescript",
    "build:dev": "cross-env NODE_ENV=development rollup -c rollup.config.ts --configPlugin typescript",
    "watch": "cross-env NODE_ENV=production IS_FLUTTER=1 rollup -c rollup.config.ts --configPlugin typescript --watch",
    "start": "cross-env NODE_ENV=development rollup -c rollup.config.ts --configPlugin typescript --watch"
  },
  "dependencies": {
    "css-selector-generator": "^3.9.1",
    "lit": "~3.3.2",
    "readium-css": "github:readium/readium-css"
  }
}
