{
  "version": 1,
  "root_dir": ".",
  "exclude": [
    "target/**",
    ".git/**",
    ".tokensave/**",
    "bin/**",
    "vendor/**",
    "**/node_modules/**",
    "**/*.js",
    "**/*.min.*",
    "**/build/**",
    "**/out/**",
    "**/.gradle/**",
    "**/dist/**",
    "**/Pods/**",
    "**/.build/**",
    "**/.symlinks/**",
    "**/.dart_tool/**",
    "**/ephemeral/**"
  ],
  "include": [],
  "max_file_size": 1048576,
  "extract_docstrings": true,
  "track_call_sites": true,
  "git_ignore": false
}
