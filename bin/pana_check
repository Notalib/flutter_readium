#!/bin/bash
#
# Runs `pana` against both publishable packages and prints the score.
# Mirrors what the CI quality workflow does, so devs can check the score
# locally before pushing.
#
# Usage:
#   bin/pana_check                 # run pana on both packages
#   bin/pana_check flutter_readium # run pana on one package only
#
# Options:
#   -v, --verbose  show pana's raw output (includes pub's verbose log dump on
#                  failure — file contents, HTTP transcripts, solver traces)
#   --no-warning   passed through to pana (matches CI)
#
# By default, noisy pub-verbose continuation lines (SLVR/IO/FINE/MSG/ERR
# markers, HTTP `|` transcripts, and entire verbose-rerun blocks) are filtered
# out so the markdown report stays readable. Use -v to see everything.

set -e
set -o pipefail

PROJECT_ROOT=$(cd "$(dirname "$0")/.." && pwd)

# Pick a dart binary: prefer `fvm dart` when the project pins a Flutter version
# via .fvmrc, fall back to a system `dart` on PATH.
if [ -f "$PROJECT_ROOT/.fvmrc" ] && command -v fvm >/dev/null 2>&1; then
  DART=(fvm dart)
elif command -v dart >/dev/null 2>&1; then
  DART=(dart)
else
  echo -e "\033[31;1mERROR: no \`dart\` on PATH and \`fvm\` is not installed.\033[0m"
  echo "Install Flutter (https://docs.flutter.dev/get-started/install) or FVM (https://fvm.app)."
  exit 1
fi

PACKAGES=(
  "flutter_readium_platform_interface"
  "flutter_readium"
)

PANA_ARGS=()
TARGETS=()
VERBOSE=
for arg in "$@"; do
  case "$arg" in
    -v|--verbose) VERBOSE=1 ;;
    --*) PANA_ARGS+=("$arg") ;;
    *)   TARGETS+=("$arg") ;;
  esac
done

# Drop pub's verbose log spam (file content dumps, HTTP transcripts, solver
# traces). Pana falls back to `pub get --verbose` when initial resolution fails
# and the resulting block can be thousands of lines. Anything inside a
# "Re-running with verbose output" block is suppressed up to the next
# timestamp; the surviving error summary line is preserved.
filter_pana() {
  if [ -n "$VERBOSE" ]; then
    cat
    return
  fi
  awk '
    /Re-running with verbose output/ { print; print "                                 [verbose pub log suppressed — re-run with -v to see it]"; suppress=1; next }
    suppress && /^[0-9]{4}-[0-9]{2}-[0-9]{2}/ { suppress=0 }
    suppress { next }
    /^[[:space:]]+(SLVR|IO  |FINE|MSG |ERR ):/ { next }
    /^[[:space:]]+\|/ { next }
    { print }
  '
}

if [ ${#TARGETS[@]} -gt 0 ]; then
  PACKAGES=("${TARGETS[@]}")
fi

if ! "${DART[@]}" pub global list 2>/dev/null | grep -q '^pana '; then
  echo -e "\033[33;1mpana not installed — activating globally...\033[0m"
  "${DART[@]}" pub global activate pana
fi

for pkg in "${PACKAGES[@]}"; do
  if [ ! -d "$PROJECT_ROOT/$pkg" ]; then
    echo -e "\033[31;1mUnknown package: $pkg\033[0m"
    exit 1
  fi

  echo -e "\033[35;1m=== pana $pkg ===\033[0m"
  (cd "$PROJECT_ROOT/$pkg" && "${DART[@]}" pub global run pana "${PANA_ARGS[@]}" . 2>&1) | filter_pana
done
