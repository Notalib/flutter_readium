#!/usr/bin/env bash
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

# Check first arg for platform name to test, if none run all platform tests

PLATFORM="${1:-all}"

function test_ios() {
  echo "No iOS unit-tests to run..."
  echo
  # iOS native unit tests are not yet part of the CI pipeline.
  # The SPM test target (flutter_readiumTests) requires FlutterFramework to be
  # present (generated by 'flutter build ios'), and RunnerTests in the example
  # workspace requires a simulator and pod install.
  #
  # To run the SPM tests manually after a full iOS build:
  #   cd flutter_readium/ios/flutter_readium && swift test
  #
  # To run RunnerTests via xcodebuild (requires simulator and pod install):
  #   cd flutter_readium/example/ios
  #   xcodebuild test \
  #     -workspace Runner.xcworkspace \
  #     -scheme Runner \
  #     -destination 'platform=iOS Simulator,name=iPhone 17 Pro'
}

function test_android() {
  echo "Running Android unit-tests..."
  echo
  EXAMPLE_DIR="$REPO_ROOT/flutter_readium/example"

  if [ ! -f "$EXAMPLE_DIR/android/gradlew" ]; then
    echo "Gradle wrapper not found — generating via 'flutter build apk --config-only'..."
    flutter pub get --directory "$EXAMPLE_DIR" > /dev/null
    flutter build apk --config-only --project-directory "$EXAMPLE_DIR"
  fi

  cd "$EXAMPLE_DIR/android"
  ./gradlew :flutter_readium:testDebugUnitTest
}

case "$PLATFORM" in
  ios)
    test_ios
    ;;
  android)
    test_android
    ;;
  all)
    test_android
    echo
    test_ios
    ;;
  *)
    echo "Unknown platform: $PLATFORM" >&2
    echo "Usage: $0 [ios|android|all] [simulator_name]" >&2
    exit 1
    ;;
esac
