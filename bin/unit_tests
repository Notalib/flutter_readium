#!/usr/bin/env bash
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

# Check first arg for platform name to test, if none run all platform tests

PLATFORM="${1:-all}"

# A booted simulator if there is one; otherwise the first available iPhone.
# Empty output if none — callers should skip rather than fail.
function first_ios_simulator_udid() {
  local udid
  udid=$(xcrun simctl list devices booted 2>/dev/null | grep -Eo '[0-9A-Fa-f-]{36}' | head -n1 || true)
  if [ -z "$udid" ]; then
    udid=$(xcrun simctl list devices available 2>/dev/null | grep -i iphone | grep -Eo '[0-9A-Fa-f-]{36}' | head -n1 || true)
  fi
  printf '%s' "$udid"
}

# iOS native unit tests run through the example app's Xcode RunnerTests target
# (app-hosted, so the plugin compiles with its real `import Flutter`). The SPM
# `flutter_readiumTests` target can NOT run via `swift test`: the generated
# FlutterFramework package is an empty placeholder and the Flutter module is
# only provided by Xcode at build time. CI does not invoke this — it runs on
# Ubuntu; iOS would need a macOS runner.
function test_ios() {
  if [ "$(uname)" != "Darwin" ] || ! command -v xcodebuild > /dev/null 2>&1; then
    echo "Skipping iOS unit-tests — requires macOS with Xcode."
    echo
    return 0
  fi

  echo "Running iOS unit-tests (RunnerTests)..."
  echo

  local EXAMPLE_DIR="$REPO_ROOT/flutter_readium/example"
  local IOS_DIR="$EXAMPLE_DIR/ios"

  # cd, not --directory: --directory loses this pubspec's SPM override.
  ( cd "$EXAMPLE_DIR" && flutter pub get > /dev/null )

  # The CocoaPods podhelper needs Flutter's generated iOS config (and the
  # ephemeral SPM packages the plugin depends on); --config-only writes them
  # without a full build.
  if [ ! -f "$IOS_DIR/Flutter/Generated.xcconfig" ]; then
    ( cd "$EXAMPLE_DIR" && flutter build ios --config-only )
  fi

  # xcodebuild's "Check Pods Manifest.lock" phase fails when the pod sandbox is
  # missing or stale (Manifest.lock is gitignored, so absent on fresh checkout).
  if [ ! -f "$IOS_DIR/Pods/Manifest.lock" ] || \
     ! diff -q "$IOS_DIR/Podfile.lock" "$IOS_DIR/Pods/Manifest.lock" > /dev/null 2>&1; then
    ( cd "$IOS_DIR" && pod install )
  fi

  local udid
  udid="$(first_ios_simulator_udid)"
  if [ -z "$udid" ]; then
    echo "No iOS simulator available — skipping iOS unit-tests."
    echo
    return 0
  fi
  echo "Using simulator: $udid"

  # arch=$(uname -m) pins the sim to the host's native arch: a bare id= destination
  # lists both arm64 and x86_64 and can select the x86_64 slice, running everything
  # under Rosetta. -quiet drops the build transcript but keeps test results + errors.
  ( cd "$IOS_DIR" && xcodebuild test \
      -workspace Runner.xcworkspace \
      -scheme Runner \
      -only-testing:RunnerTests \
      -destination "platform=iOS Simulator,id=$udid,arch=$(uname -m)" \
      -quiet )
}

function test_android() {
  echo "Running Android unit-tests..."
  echo
  EXAMPLE_DIR="$REPO_ROOT/flutter_readium/example"

  if [ ! -f "$EXAMPLE_DIR/android/gradlew" ]; then
    echo "Gradle wrapper not found — generating via 'flutter build apk --config-only'..."
    # cd, not --directory (see test_ios).
    ( cd "$EXAMPLE_DIR" && flutter pub get > /dev/null )
    # flutter build apk has no --project-directory flag.
    ( cd "$EXAMPLE_DIR" && flutter build apk --config-only )
  fi

  cd "$EXAMPLE_DIR/android" || exit 1
  ./gradlew :flutter_readium:testDebugUnitTest
}

function test_web() {
  WEB_DIR="$REPO_ROOT/flutter_readium/web/src"
  cd "$WEB_DIR" || exit 1
  echo "Running web unit-tests..."
  npm test
}

case "$PLATFORM" in
  ios)
    test_ios
    ;;
  android)
    test_android
    ;;
  web)
    test_web
    ;;
  all)
    test_android
    echo
    test_ios
    echo
    test_web
    ;;
  *)
    echo "Unknown platform: $PLATFORM" >&2
    echo "Usage: $0 [ios|android|all] [simulator_name]" >&2
    exit 1
    ;;
esac
