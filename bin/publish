#!/bin/bash
#
# Publish the publishable packages to pub.dev with a SELF-CONTAINED
# analysis_options.yaml, so pub.dev's pana scores the real config.
#
# Each package's committed analysis_options.yaml shares config via
# `include: ../analysis_options.base.yaml`. That path is outside the package and
# is therefore NOT in the published tarball — pub.dev's pana would lose the
# formatter/linter config and dock the score. This wrapper stages the package in
# a temp dir, inlines the effective config there (via
# bin/materialize_analysis_options), and publishes that staged copy. Always
# publish through this script, never `dart pub publish` directly.
#
# Publishes in dependency order: flutter_readium_platform_interface first
# (flutter_readium depends on it).
#
# Usage:
#   bin/publish                       # publish both packages (interactive)
#   bin/publish flutter_readium       # publish one package only
#   bin/publish --dry-run             # validate without uploading
#   bin/publish --allow-dirty         # publish even with tracked local changes
#   bin/publish --force               # skip the confirmation prompt
#
# Any --flag is passed through to `dart pub publish`; bare names select packages.

# Bootstrap PATH so fvm/dart resolve in non-interactive shells (CI / AI agents),
# which don't source ~/.zshrc. Sets REPO_ROOT and `set -eo pipefail`.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

PROJECT_ROOT="$REPO_ROOT"

# Pick a dart binary the same way bin/pana_check does: prefer `fvm dart` when the
# project pins a Flutter version via .fvmrc, else a system `dart` on PATH.
if [ -f "$PROJECT_ROOT/.fvmrc" ] && command -v fvm >/dev/null 2>&1; then
  DART=(fvm dart)
elif command -v dart >/dev/null 2>&1; then
  DART=(dart)
else
  echo -e "\033[31;1mERROR: no \`dart\` on PATH and \`fvm\` is not installed.\033[0m"
  exit 1
fi

PACKAGES=(
  "flutter_readium_platform_interface"
  "flutter_readium"
)

PUBLISH_ARGS=()
TARGETS=()
ALLOW_DIRTY=
for arg in "$@"; do
  case "$arg" in
    --allow-dirty) ALLOW_DIRTY=1 ;;
    --*) PUBLISH_ARGS+=("$arg") ;;
    *)   TARGETS+=("$arg") ;;
  esac
done

if [ ${#TARGETS[@]} -gt 0 ]; then
  PACKAGES=("${TARGETS[@]}")
fi

STAGE_ROOTS=()
cleanup_stages() {
  for dir in "${STAGE_ROOTS[@]}"; do
    if [ -n "$dir" ] && [ -d "$dir" ]; then
      rm -rf "$dir"
    fi
  done
  STAGE_ROOTS=()
}
trap cleanup_stages EXIT INT TERM

check_dirty_package() {
  local pkg="$1"
  local modified

  modified="$(git -C "$PROJECT_ROOT" status --short --untracked-files=no -- "$pkg")"
  if [ -n "$modified" ]; then
    if [ -n "$ALLOW_DIRTY" ]; then
      echo -e "\033[33;1mWARNING: checked-in files are modified under $pkg.\033[0m"
      echo "Publishing will use those local modifications from the staged copy:"
    else
      echo -e "\033[31;1mERROR: checked-in files are modified under $pkg.\033[0m"
      echo "Refusing to publish from a dirty package checkout."
      echo "Use --allow-dirty if you intentionally want to publish these local changes:"
    fi
    printf '%s\n' "$modified"
    echo ""

    if [ -z "$ALLOW_DIRTY" ]; then
      exit 1
    fi
  fi
}

STAGED_PKG_DIR=
stage_package_copy() {
  local pkg="$1"
  local stage_root gen

  stage_root="$(mktemp -d)"
  STAGE_ROOTS+=("$stage_root")

  cp -R "$PROJECT_ROOT/$pkg" "$stage_root/$pkg"
  if [ "$pkg" = "flutter_readium" ]; then
    cp -R "$PROJECT_ROOT/flutter_readium_platform_interface" "$stage_root/flutter_readium_platform_interface"
  fi

  gen="$(mktemp)"
  "$PROJECT_ROOT/bin/materialize_analysis_options" "$PROJECT_ROOT/$pkg" > "$gen"
  mv "$gen" "$stage_root/$pkg/analysis_options.yaml"

  STAGED_PKG_DIR="$stage_root/$pkg"

  # Publish against the same dependency graph consumers resolve from pub.dev,
  # not the local path override used for in-repo development.
  rm -f "$STAGED_PKG_DIR/pubspec_overrides.yaml"
}

build_staged_web_bundle() {
  local pkg_dir="$1"

  find "$pkg_dir/assets/helpers" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
  find "$pkg_dir/build" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true

  "$PROJECT_ROOT/bin/build_js" --skip-example-copy "$pkg_dir"
}

for pkg in "${PACKAGES[@]}"; do
  if [ ! -d "$PROJECT_ROOT/$pkg" ]; then
    echo -e "\033[31;1mUnknown package: $pkg\033[0m"
    exit 1
  fi

  echo -e "\033[35;1m=== publish $pkg ===\033[0m"

  check_dirty_package "$pkg"

  stage_package_copy "$pkg"

  # Stats reports are local build artifacts and must not be published.
  if [ "$pkg" = "flutter_readium" ]; then
    build_staged_web_bundle "$STAGED_PKG_DIR"
  fi

  (cd "$STAGED_PKG_DIR" && "${DART[@]}" pub get)
  (cd "$STAGED_PKG_DIR" && "${DART[@]}" pub publish "${PUBLISH_ARGS[@]}")
done
