#!/bin/bash
#
# Prepare a lockstep release of both publishable packages.
#
# Does the mechanical, error-prone parts of cutting a release so a human never
# has to (the bits that, done by hand, silently ship a wrong dependency):
#   1. bump `version:` in both pubspecs,
#   2. bump flutter_readium's constraint on flutter_readium_platform_interface
#      to match (a `^0.0.x` caret excludes the next patch, so this MUST move),
#   3. stamp the curated `## Unreleased` changelog content into a dated
#      `## [<version>] - <date>` section in both packages, leaving a fresh
#      empty `## Unreleased` on top,
#   4. commit + annotated-tag `v<version>`.
#
# It deliberately does NOT push — you decide when the tag reaches the canonical
# repo. Pushing the tag is what triggers .github/workflows/release.yml to
# publish to pub.dev (OIDC), so it must land on notalib/flutter_readium.
#
# The changelog *content* stays hand-curated: write entries under `## Unreleased`
# as you work (consumer-facing only — see CLAUDE.md), and this script just dates
# and seals them. It never generates entries from commits.
#
# Usage:
#   bin/release_prep <version>          # e.g. bin/release_prep 0.0.2
#   bin/release_prep <version> --no-tag # commit only, skip the tag

# Bootstrap PATH / REPO_ROOT for non-interactive shells (repo convention).
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

VERSION="${1:-}"
shift || true
NO_TAG=0
for arg in "$@"; do
  case "$arg" in
    --no-tag) NO_TAG=1 ;;
    *) echo "ERROR: unknown argument: $arg"; exit 1 ;;
  esac
done

if [ -z "$VERSION" ]; then
  echo "Usage: bin/release_prep <version> [--no-tag]"
  echo "Example: bin/release_prep 0.0.2"
  exit 1
fi

if ! echo "$VERSION" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "ERROR: version must be semver (e.g. 0.0.2), got: $VERSION"
  exit 1
fi

DATE=$(date +%Y-%m-%d)
PLUGIN_PUBSPEC="$REPO_ROOT/flutter_readium/pubspec.yaml"
IFACE_PUBSPEC="$REPO_ROOT/flutter_readium_platform_interface/pubspec.yaml"
PLUGIN_CHANGELOG="$REPO_ROOT/flutter_readium/CHANGELOG.md"
IFACE_CHANGELOG="$REPO_ROOT/flutter_readium_platform_interface/CHANGELOG.md"

# --- Preconditions ----------------------------------------------------------

# The release commit must contain ONLY this script's changes, so the curated
# changelog (and anything else) has to be committed first.
if [ -n "$(git -C "$REPO_ROOT" status --porcelain)" ]; then
  echo "ERROR: working tree is dirty. Commit or stash first so the release"
  echo "       commit contains only the version bump."
  echo
  git -C "$REPO_ROOT" status --short
  exit 1
fi

# Validate that publish works
"$REPO_ROOT/bin/publish" --dry-run || {
  echo "ERROR: dry-run publish failed. Fix the issues before preparing a release."
  exit 1
}

for changelog in "$PLUGIN_CHANGELOG" "$IFACE_CHANGELOG"; do
  if grep -q "^## \[$VERSION\]" "$changelog"; then
    echo "ERROR: $changelog already has a section for [$VERSION]"
    exit 1
  fi
  if ! grep -q '^## Unreleased' "$changelog"; then
    echo "ERROR: $changelog has no '## Unreleased' section to seal"
    exit 1
  fi
done

if [ "$NO_TAG" -eq 0 ] && git -C "$REPO_ROOT" rev-parse "v$VERSION" >/dev/null 2>&1; then
  echo "ERROR: tag v$VERSION already exists"
  exit 1
fi

# --- 1. Bump pubspec versions -----------------------------------------------
for pubspec in "$PLUGIN_PUBSPEC" "$IFACE_PUBSPEC"; do
  sed -i '' "s/^version: .*/version: $VERSION/" "$pubspec"
  if ! grep -q "^version: $VERSION$" "$pubspec"; then
    echo "ERROR: failed to set version: $VERSION in $pubspec"
    exit 1
  fi
  echo "  $pubspec → version: $VERSION"
done

# --- 2. Bump the inter-package constraint (the caret gotcha) -----------------
# Preserve indentation; drop any trailing placeholder comment. Then VERIFY the
# bump landed — the previous implementation silently no-op'd here.
sed -i '' -E \
  "s|^([[:space:]]*flutter_readium_platform_interface:)[[:space:]]+\^?[0-9][0-9.]*.*$|\1 ^$VERSION|" \
  "$PLUGIN_PUBSPEC"
if ! grep -qE "^[[:space:]]*flutter_readium_platform_interface:[[:space:]]+\^$VERSION([[:space:]]|\$)" "$PLUGIN_PUBSPEC"; then
  echo "ERROR: failed to bump flutter_readium_platform_interface constraint to ^$VERSION."
  echo "       Check the dependency line format in $PLUGIN_PUBSPEC."
  exit 1
fi
echo "  $PLUGIN_PUBSPEC → flutter_readium_platform_interface: ^$VERSION"

# --- 3. Seal the curated Unreleased changelog into a dated section ----------
for changelog in "$PLUGIN_CHANGELOG" "$IFACE_CHANGELOG"; do
  sed -i '' "s/^## Unreleased\$/## Unreleased\n\n## [$VERSION] - $DATE/" "$changelog"
  if ! grep -q "^## \[$VERSION\] - $DATE\$" "$changelog"; then
    echo "ERROR: failed to add [$VERSION] section to $changelog"
    exit 1
  fi
  echo "  $changelog → [$VERSION] - $DATE"
done

# --- 4. Commit (+ tag) ------------------------------------------------------
git -C "$REPO_ROOT" commit -aqm "chore(release): v$VERSION"
echo "  committed: chore(release): v$VERSION"

if [ "$NO_TAG" -eq 0 ]; then
  git -C "$REPO_ROOT" tag -a "v$VERSION" -m "v$VERSION"
  echo "  tagged: v$VERSION"
fi

echo
echo "Release $VERSION prepared. Nothing pushed."
echo
echo "Review:"
echo "  git show v$VERSION"
echo
# Pushing the tag to Notalib/flutter_readium is what triggers the pub.dev
# publish. Leave the remote to the dev — just name the canonical target.
echo "Push the branch and tag v$VERSION to Notalib/flutter_readium when ready."
