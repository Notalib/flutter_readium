#!/usr/bin/env bash
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

# Builds every local test fixture from an already-checked-out
# readium-test-resources clone — both the native `assets/pubs/` bundle and the
# exploded/trimmed `example/web/test-*/` fixtures. Shared by bin/fetch_test_resources
# (local dev, clones on demand) and .github/actions/fetch-test-resources (CI,
# checks out via actions/checkout). Add new fixture source content to
# https://github.com/Notalib/readium-test-resources rather than hand-maintaining
# it here.
#
# Usage: bin/build_test_fixtures <test-resources-checkout-dir>

RESOURCES_CHECKOUT="${1:?Usage: bin/build_test_fixtures <test-resources-checkout-dir>}"
PUBS_DIR="$REPO_ROOT/flutter_readium/example/assets/pubs"
WEB_DIR="$REPO_ROOT/flutter_readium/example/web"

bash "$RESOURCES_CHECKOUT/bin/build_publications.sh" build "$PUBS_DIR"

echo "Deriving example/web/ test fixtures…"
trim() {
  if [ -n "${3:-}" ]; then
    python3 "$RESOURCES_CHECKOUT/bin/trim_webpub.py" "$PUBS_DIR/$1" "$WEB_DIR/$2" "$3"
  else
    python3 "$RESOURCES_CHECKOUT/bin/trim_webpub.py" "$PUBS_DIR/$1" "$WEB_DIR/$2"
  fi
}

# Remote-manifest fixtures host their audio remotely, so there is nothing to
# package or trim — just serve the manifest.json verbatim at the fixture origin.
# Hrefs are authored correctly at the source: absolute where the media is
# cross-origin (e.g. flatland), relative + absolute self where same-origin.
copy_manifest() {
  rm -rf "$WEB_DIR/$2"
  mkdir -p "$WEB_DIR/$2"
  cp "$PUBS_DIR/$1" "$WEB_DIR/$2/manifest.json"
}

trim 38533_overlay_preview.webpub               test-fixtures/overlay            4
trim 38533.audiobook                            test-fixtures/audiobook          3
trim 38533_guided_navigation_preview.webpub     test-fixtures/guided-navigation  4
trim 50272-nota-comics.webpub                   test-fixtures/comic
trim 50272-nota-comics.divina                   test-fixtures/divina
trim 712199_ebook.webpub                        test-fixtures/ebook
copy_manifest flatland.json                     test-fixtures/audiobook-remote
trim test-fixed-layout.webpub                   test-fixtures/fixed-layout
trim test-peter-rabbit.webpub                   test-fixtures/peter-rabbit
