#!/bin/bash
#
# Emit a SELF-CONTAINED analysis_options.yaml for a publishable package.
#
# Why this exists
# ---------------
# Each package's committed analysis_options.yaml does
#   include: ../analysis_options.base.yaml
# to share one analyzer/linter/formatter config across the repo (DRY). That
# path escapes the package directory, so it is GREAT for local development and
# IDE analysis but BROKEN the moment the package is analyzed in isolation:
# `dart pub publish` only packs files under the package root, and pub.dev's pana
# scores that tarball. There the `../` include is dead, so the real formatter
# (page_width: 120) and the curated linter rules silently fail to load — pana
# then reports dozens of bogus format/lint issues and the score drops.
#
# This script materializes the effective config by inlining the base file
# (whose only remaining include — `package:flutter_lints/...` — resolves fine
# from a declared dev_dependency) and appending the package's own extra
# sections. Run it at publish time (bin/publish, .github/workflows/release.yml)
# and when staging for pana (bin/pana_check) so the score matches pub.dev.
#
# Usage:
#   bin/materialize_analysis_options <package-dir>   # prints YAML to stdout
#
# Assumption: base and the per-package overrides have DISJOINT top-level YAML
# keys (base owns include/formatter/linter; packages add only `analyzer:`), so a
# plain concatenation is a valid merge. If a package ever needs to override a
# key the base already sets, switch to a real YAML merge instead.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

PKG_DIR="${1:?Usage: bin/materialize_analysis_options <package-dir>}"

# Resolve to an absolute path whether given relative or absolute.
PKG_DIR="$(cd "$PKG_DIR" && pwd)"

BASE="$REPO_ROOT/analysis_options.base.yaml"
PKG_OPTS="$PKG_DIR/analysis_options.yaml"

[ -f "$BASE" ] || { echo "ERROR: base config not found: $BASE" >&2; exit 1; }
[ -f "$PKG_OPTS" ] || { echo "ERROR: package config not found: $PKG_OPTS" >&2; exit 1; }

echo "# GENERATED by bin/materialize_analysis_options — DO NOT EDIT."
echo "# Source of truth: analysis_options.base.yaml + this package's overrides."
echo "# The committed analysis_options.yaml uses a cross-package include that"
echo "# only works in-repo; this self-contained form is what gets published."
echo ""

# 1. Inline the shared base verbatim (it self-resolves via flutter_lints).
cat "$BASE"

# 2. Append this package's own sections, dropping the dead relative include and
#    any blank lines that led it. If nothing remains, the base alone is emitted.
#    `grep -v` exits 1 when it filters out every line (a package with only the
#    include and nothing else) — expected here, so don't let set -e/pipefail trip.
PKG_EXTRA="$( { grep -vE '^[[:space:]]*include:[[:space:]]*\.\..*analysis_options\.base\.yaml' "$PKG_OPTS" || true; } \
  | sed -E '/[^[:space:]]/,$!d')"

if [ -n "$PKG_EXTRA" ]; then
  echo ""
  echo "# ---- package-specific overrides (from $(basename "$PKG_DIR")/analysis_options.yaml) ----"
  printf '%s\n' "$PKG_EXTRA"
fi
