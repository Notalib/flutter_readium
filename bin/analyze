#!/usr/bin/env bash
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

# Analyze all packages in the repo.
echo "Analyzing flutter_readium_platform_interface..."
dart analyze --fatal-infos --fatal-warnings "$REPO_ROOT/flutter_readium_platform_interface"

echo "Analyzing flutter_readium..."
dart analyze --fatal-infos --fatal-warnings "$REPO_ROOT/flutter_readium"

echo "Analyzing example app..."
dart analyze --fatal-infos --fatal-warnings "$REPO_ROOT/flutter_readium/example"
