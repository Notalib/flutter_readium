#!/usr/bin/env bash

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

"$REPO_ROOT/bin/forAll" flutter pub get

if [ "$(uname)" = "Darwin" ]; then
  ( cd "$REPO_ROOT/flutter_readium/example/ios" && pod update && pod install --repo-update )
fi

# npm <11.15.0 rejects min-release-age + --before together (fixed in npm/cli#9339).
_npm_ver="$(npm --version)"; _npm_major="${_npm_ver%%.*}"; _npm_minor="${_npm_ver#*.}"; _npm_minor="${_npm_minor%%.*}"
if [ "$_npm_major" -lt 11 ] || { [ "$_npm_major" -eq 11 ] && [ "$_npm_minor" -lt 15 ]; }; then
  echo "error: npm $_npm_ver is too old — upgrade to 11.15.0+ (e.g. nvm install <node/24/lts>)" >&2
  exit 1
fi

# Install helper-script dependencies (used by example/lib/flutter_readium:copy_js_file)
(cd "$REPO_ROOT/flutter_readium/assets/_helper_scripts" && npm install --ignore-scripts)

# Make sure web dependencies are installed (package.json lives at the plugin root)
(cd "$REPO_ROOT/flutter_readium" && (npm ci --ignore-scripts && npm run build:dev))

# Fetch test publications from the external test-resources repo.
echo "Fetching test publications from readium-test-resources…"
_tmp_res="$(mktemp -d)"
git clone --depth=1 git@github.com:Notalib/readium-test-resources.git "$_tmp_res"
bash "$_tmp_res/bin/build-publications.sh" build "$REPO_ROOT/flutter_readium/example/assets/pubs"
rm -rf "$_tmp_res"

# Optional: AI code-search index (tokensave, https://github.com/aovestdipaperino/tokensave).
# Entirely no-op for anyone who doesn't have the tokensave CLI installed.
# Install with: brew install aovestdipaperino/tap/tokensave
if command -v tokensave >/dev/null 2>&1; then
  echo "tokensave detected — configuring code index + refresh hooks"
  # Build the index DB on a fresh checkout (init also writes a default config we override next).
  [ -f "$REPO_ROOT/.tokensave/tokensave.db" ] || ( cd "$REPO_ROOT" && tokensave init </dev/null )
  # Apply the repo's curated, portable config (root_dir ".", build/Pods/vendored excluded).
  cp "$REPO_ROOT/.githooks/tokensave.config.json" "$REPO_ROOT/.tokensave/config.json"
  # Activate the shared refresh hooks (post-commit / merge / checkout / rewrite).
  git -C "$REPO_ROOT" config core.hooksPath .githooks
  # Reindex honoring the curated excludes.
  ( cd "$REPO_ROOT" && tokensave sync --force )
fi
