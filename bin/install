#!/usr/bin/env bash

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

# npm <11.15.0 rejects min-release-age + --before together (fixed in npm/cli#9339).
_npm_ver="$(npm --version)"; _npm_major="${_npm_ver%%.*}"; _npm_minor="${_npm_ver#*.}"; _npm_minor="${_npm_minor%%.*}"
if [ "$_npm_major" -lt 11 ] || { [ "$_npm_major" -eq 11 ] && [ "$_npm_minor" -lt 15 ]; }; then
  echo "error: npm $_npm_ver is too old — upgrade to 11.15.0+ (e.g. nvm install --lts)" >&2
  exit 1
fi

"$REPO_ROOT/bin/forAll" flutter pub get

# Install helper-script dependencies (used by example/lib/flutter_readium:copy_js_file)
(cd "$REPO_ROOT/flutter_readium/assets/_helper_scripts" && npm ci --ignore-scripts && npm run build:dev)

# Make sure web dependencies are installed (package.json lives at the plugin root)
(cd "$REPO_ROOT/flutter_readium" && (npm ci --ignore-scripts && npm run build:dev))

"$REPO_ROOT/bin/fetch_test_resources"

# Optional: AI code-search index (CodeGraph, https://github.com/colbymchenry/codegraph).
# Entirely no-op for anyone who doesn't have the codegraph CLI installed.
# Install with: brew install codegraph  (or npm i -g @colbymchenry/codegraph)
if command -v codegraph >/dev/null 2>&1; then
  echo "codegraph detected — configuring code index + refresh hooks"
  # Build the index on a fresh checkout; .codegraph/ is gitignored via its own .gitignore.
  [ -f "$REPO_ROOT/.codegraph/codegraph.db" ] || ( cd "$REPO_ROOT" && codegraph init )
  # Activate the shared refresh hooks (post-commit / merge / checkout / rewrite).
  git -C "$REPO_ROOT" config core.hooksPath .githooks
fi
