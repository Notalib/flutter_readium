{
  "explorer.excludeGitIgnore": true,
  "files.watcherExclude": {
    "**/.fvm": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/ios/.symlinks/**": true,
    "**/*/*.js": true,
    "**/*/*.css": true,
    ".claude/worktrees": true
  },
  "files.readonlyInclude": {
    "**/*.g.dart": true,
    "**/*.freezed.dart": true,
    "**/*.gr.dart": true,
    "**/*.config.dart": true,
    "**/*/*.js": true,
    "**/*/*.css": true
  },
  "js/ts.implicitProjectConfig.checkJs": false,
  "eslint.workingDirectories": [
    "flutter_readium/assets/_helper_scripts/"
  ],
  "dart.lineLength": 120,
  "[dart]": {
    "editor.rulers": [
      120
    ]
  },
  "cSpell.enabledFileTypes": {
    "dart": true
  },
  "cSpell.ignorePaths": [
    "**/.pub-cache/**",
    "**/pubspec.lock",
    "**/node_modules/**",
    "**/vscode-extension/**",
    "**/.git/objects/**",
    "**/assets/l10n/**",
    "!**/assets/l10n/**/da.yaml",
    "**/assets/feeds/**",
    "**/project.pbxproj",
    "**/Podfile.lock"
  ],
  "cSpell.language": "en,da,sv,no",
  "cSpell.words": [
    "acsm",
    "androidx",
    "animejs",
    "ascii",
    "Ascii",
    "audioref",
    "AVTTS",
    "behaviour",
    "charsets",
    "Charsets",
    "claude",
    "comicbook",
    "CSASCII",
    "dartx",
    "dfunc",
    "divina",
    "epub",
    "Epub",
    "EPUB",
    "epubcfi",
    "fimber",
    "Fimber",
    "flutterreadium",
    "fvmrc",
    "GITHUB",
    "gradlew",
    "imgref",
    "injectables",
    "jsonable",
    "kotlin",
    "kotlinx",
    "ktlint",
    "lcpl",
    "Mantano",
    "mediatype",
    "microenterprise",
    "mktemp",
    "Notalib",
    "NYPL",
    "opds",
    "Opds",
    "pana",
    "podfile",
    "podspec",
    "prefs",
    "Prefs",
    "preorder",
    "pubspec",
    "readium",
    "reflowable",
    "rels",
    "RWPM",
    "síða",
    "softprops",
    "subcollection",
    "Subcollection",
    "subcollections",
    "subosito",
    "syncnarr",
    "textref",
    "tokensave",
    "Transformability",
    "treemap",
    "videoref",
    "Worktree",
    "worktrees",
    "xywh"
  ],
  "java.configuration.updateBuildConfiguration": "interactive",
  "dart.mcpServer": true,
  "chat.tools.terminal.autoApprove": {
    "flutter": true,
    "dart": true,
    "./gradlew": true,
    "command": true,
    "ktlint": true,
    "npm run build": true,
    "bin/analyze": true
  }
}
