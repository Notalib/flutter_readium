{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "example",
      "cwd": "flutter_readium/example",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "preLaunchTask": "build_helper_scripts"
    },
    {
      "name": "example (web)",
      "cwd": "flutter_readium/example",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "flutterMode": "debug",
      "preLaunchTask": "build_web"
    },
    {
      "name": "example (profile mode)",
      "cwd": "flutter_readium/example",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "preLaunchTask": "build_helper_scripts"
    },
    {
      "name": "example (release mode)",
      "cwd": "flutter_readium/example",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "preLaunchTask": "build_helper_scripts"
    },
    {
      "name": "integration tests (example)",
      "cwd": "flutter_readium/example",
      "program": "integration_test",
      "request": "launch",
      "type": "dart",
      "preLaunchTask": "build_helper_scripts"
    },
    {
      "command": "npm run serve",
      "name": "Run comicbook demo",
      "cwd": "${workspaceFolder}/flutter_readium/assets/_helper_scripts",
      "request": "launch",
      "type": "node-terminal"
    },
  ]
}
